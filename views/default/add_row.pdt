<?php
$module_id = $module->id ?? null;
if (empty($module_id)) {
    Loader::loadModels($this, ['ModuleManager']);
    $dynadot_mods = $this->ModuleManager->getByClass('dynadot', Configure::get('Blesta.company_id'));
    $module_id = $dynadot_mods[0]->id ?? null;
}

$this->Widget->clear();
$this->Widget->setLinkButtons([
    [
        'name' => $this->_('Dynadot.back_to_manage', true),
        'icon' => 'bi bi-arrow-left me-1',
        'attributes' => ['href' => $this->base_uri . 'settings/company/modules/manage/' . ($module_id ?? '') . '/']
    ]
]);
$this->Form->create(null, ['class' => 'disable-on-submit']);
$this->Widget->create($this->_('Dynadot.add_row.box_title', true));
?>
<h6 class="form-section-header"><?php $this->_('Dynadot.add_row.basic_title'); ?></h6>

<div class="mb-3">
    <label for="user" class="form-label"><?php $this->_('Dynadot.row_meta.user'); ?></label>
    <?php $this->Form->fieldText('user', $vars->user ?? null, ['id' => 'user', 'class' => 'form-control']); ?>
</div>

<div class="mb-3">
    <label for="key" class="form-label"><?php $this->_('Dynadot.row_meta.key'); ?></label>
    <?php $this->Form->fieldText('key', $vars->key ?? null, ['id' => 'key', 'class' => 'form-control']); ?>
</div>

<div class="mb-3">
    <label for="secret" class="form-label"><?php $this->_('Dynadot.row_meta.secret'); ?></label>
    <?php $this->Form->fieldPassword('secret', ['id' => 'secret', 'value' => ($vars->secret ?? null), 'class' => 'form-control']); ?>
</div>

<div class="mb-3">
    <div class="form-check">
        <?php $this->Form->fieldCheckbox('sandbox', 'true', ($vars->sandbox ?? 'false') === 'true', ['id' => 'sandbox', 'class' => 'form-check-input']); ?>
        <label for="sandbox" class="form-check-label"><?php $this->_('Dynadot.row_meta.sandbox'); ?></label>
    </div>
</div>

<?php $this->Widget->footer(); ?>
<div class="d-flex justify-content-end">
    <?php $this->Form->fieldSubmit('save', $this->_('Dynadot.add_row.add_btn', true), ['class' => 'btn btn-primary']); ?>
</div>
<?php $this->Widget->end(); ?>
<?php $this->Form->end(); ?>
