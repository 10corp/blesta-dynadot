<?php $this->Form->create(); ?>
<div class="p-3">
    <h6 class="form-section-header"><?php $this->_('Dynadot.tab_dnsrecords.title_list'); ?></h6>
    <p><?php $this->_('Dynadot.tab_dnsrecords.help_text'); ?></p>
    <div class="d-flex justify-content-end mb-2">
        <button type="button" class="btn btn-sm btn-outline-secondary" id="add_dns_record"><i class="bi bi-plus-lg"></i> <?php $this->_('Dynadot.tab_dnsrecords.add_record'); ?></button>
    </div>
    <div class="table-responsive">
        <table class="table table-hover mb-3" id="dns_records">
            <thead>
                <tr>
                    <th><?php $this->_('Dynadot.tab_dnsrecords.record_type'); ?></th>
                    <th><?php $this->_('Dynadot.tab_dnsrecords.host'); ?></th>
                    <th><?php $this->_('Dynadot.tab_dnsrecords.value'); ?></th>
                    <th><?php $this->_('Dynadot.tab_dnsrecords.extra'); ?></th>
                    <th><?php $this->_('Dynadot.tab_dnsrecords.options'); ?></th>
                </tr>
            </thead>
            <tbody>
                <?php
                $i = 0;
                do {
                    ?>
                    <tr>
                        <td><?php $this->Form->fieldSelect('main_record_type' . $i, $vars->record_types ?? [], $vars->{'main_record_type' . $i} ?? null, ['class' => 'form-select form-select-sm']); ?></td>
                        <td><?php $this->Form->fieldText('subdomain' . $i, $vars->{'subdomain' . $i} ?? null, ['class' => 'form-control form-control-sm', 'placeholder' => '@']); ?></td>
                        <td><?php $this->Form->fieldText('main_record' . $i, $vars->{'main_record' . $i} ?? null, ['class' => 'form-control form-control-sm']); ?></td>
                        <td><?php $this->Form->fieldText('record_x' . $i, $vars->{'record_x' . $i} ?? null, ['class' => 'form-control form-control-sm', 'placeholder' => $this->_('Dynadot.tab_dnsrecords.extra_placeholder', true)]); ?></td>
                        <td><button type="button" class="btn btn-sm btn-outline-danger delete_row" title="<?php echo $this->Html->safe($this->_('Blesta.delete', true)); ?>"><i class="bi bi-trash"></i></button></td>
                    </tr>
                    <?php
                    $i++;
                } while (isset($vars->{'main_record_type' . $i}));
                ?>
            </tbody>
        </table>
    </div>
    <div class="d-flex justify-content-end gap-2">
        <?php $this->Form->fieldSubmit('save', $this->_('Dynadot.tab_dnsrecords.field_submit', true), ['class' => 'btn btn-primary']); ?>
    </div>
</div>
<?php $this->Form->end(); ?>

<script type="text/javascript">
(function () {
    var record_count = <?php echo (int) $i; ?>;
    var table = document.getElementById('dns_records');
    var add = document.getElementById('add_dns_record');
    if (!table || !add) {
        return;
    }
    var body = table.querySelector('tbody');

    function reset(row) {
        row.querySelectorAll('input').forEach(function (el) { el.value = ''; });
        row.querySelectorAll('select').forEach(function (el) { el.selectedIndex = 0; });
    }

    add.addEventListener('click', function (e) {
        e.preventDefault();
        var clone = body.querySelector('tr').cloneNode(true);
        clone.querySelectorAll('input, select').forEach(function (el) {
            var name = el.getAttribute('name');
            if (name) {
                var new_name = name.replace(/\d+$/, record_count);
                el.setAttribute('name', new_name);
                el.setAttribute('id', new_name);
            }
        });
        reset(clone);
        body.appendChild(clone);
        record_count++;
    });

    // Delegated so that rows added above are covered too
    table.addEventListener('click', function (e) {
        var btn = e.target.closest('.delete_row');
        if (!btn) {
            return;
        }
        e.preventDefault();
        var row = btn.closest('tr');
        if (body.querySelectorAll('tr').length > 1) {
            row.remove();
        } else {
            reset(row);
        }
    });
})();
</script>
