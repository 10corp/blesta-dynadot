<div class="p-3">
    <h6 class="form-section-header"><?php $this->_('Dynadot.tab_dnssec.title'); ?></h6>
    <p><?php $this->_('Dynadot.tab_dnssec.description'); ?></p>

    <?php if (!empty($vars->add_view)) { ?>
        <h6 class="mt-3"><?php $this->_('Dynadot.tab_dnssec.title_add'); ?></h6>
        <?php
        $this->Form->create();
        $this->Form->fieldHidden('action', 'add');
        ?>
        <div class="mb-3">
            <?php
            $this->Form->label($this->_('Dynadot.dnssec.key_tag', true), 'key_tag', ['class' => 'form-label']);
            $this->Form->fieldText('key_tag', $vars->key_tag ?? '', ['id' => 'key_tag', 'class' => 'form-control']);
            ?>
        </div>
        <div class="mb-3">
            <?php
            $this->Form->label($this->_('Dynadot.dnssec.algorithm', true), 'algorithm', ['class' => 'form-label']);
            $this->Form->fieldSelect('algorithm', $vars->algorithms ?? [], $vars->algorithm ?? 13, ['id' => 'algorithm', 'class' => 'form-select']);
            ?>
        </div>
        <div class="mb-3">
            <?php
            $this->Form->label($this->_('Dynadot.dnssec.digest_type', true), 'digest_type', ['class' => 'form-label']);
            $this->Form->fieldSelect('digest_type', $vars->digest_types ?? [], $vars->digest_type ?? 2, ['id' => 'digest_type', 'class' => 'form-select']);
            ?>
        </div>
        <div class="mb-3">
            <?php
            $this->Form->label($this->_('Dynadot.dnssec.digest', true), 'digest', ['class' => 'form-label']);
            $this->Form->fieldText('digest', $vars->digest ?? '', ['id' => 'digest', 'class' => 'form-control']);
            ?>
        </div>
        <div class="d-flex justify-content-end gap-2">
            <?php $this->Form->fieldSubmit('save', $this->_('Dynadot.tab_dnssec.field_add', true), ['class' => 'btn btn-primary']); ?>
        </div>
        <?php $this->Form->end(); ?>
    <?php } else { ?>
        <div class="d-flex justify-content-end">
            <a class="btn btn-outline-secondary" href="<?php echo $this->Html->safe($this->base_uri . 'clients/servicetab/' . ($client_id ?? '') . '/' . ($service_id ?? '') . '/tabDnssec/?action=add'); ?>"><i class="fas fa-plus"></i> <?php $this->_('Dynadot.tab_dnssec.field_add'); ?></a>
        </div>
    <?php } ?>

    <hr />
    <h6><?php $this->_('Dynadot.tab_dnssec.title_clear'); ?></h6>
    <p><?php $this->_('Dynadot.tab_dnssec.clear_description'); ?></p>
    <?php
    $this->Form->create();
    $this->Form->fieldHidden('action', 'clear');
    ?>
    <div class="d-flex justify-content-end">
        <?php $this->Form->fieldSubmit('clear', $this->_('Dynadot.tab_dnssec.field_clear', true), ['class' => 'btn btn-danger']); ?>
    </div>
    <?php $this->Form->end(); ?>
</div>
