<?php $this->Form->create(); ?>
<div class="p-3">
    <h6 class="form-section-header"><?php $this->_('Dynadot.tab_email_forwarding.title_list'); ?></h6>
    <div class="alert alert-info">
        <?php $this->_('Dynadot.tab_email_forwarding.help_text_no_fetch'); ?>
    </div>
    <div class="d-flex justify-content-end mb-2">
        <button type="button" class="btn btn-sm btn-outline-secondary" id="add_forward"><i class="bi bi-plus-lg"></i> <?php $this->_('Dynadot.tab_email_forwarding.add_record'); ?></button>
    </div>
    <div class="table-responsive">
        <table class="table table-hover mb-3" id="email_forwards">
            <thead>
                <tr>
                    <th><?php $this->_('Dynadot.tab_email_forwarding.username'); ?></th>
                    <th><?php $this->_('Dynadot.tab_email_forwarding.destination'); ?></th>
                    <th><?php $this->_('Dynadot.tab_email_forwarding.options'); ?></th>
                </tr>
            </thead>
            <tbody>
                <?php
                $i = 0;
                do {
                    ?>
                    <tr>
                        <td><?php $this->Form->fieldText('username' . $i, $this->Html->ifSet($vars->{'username' . $i}), ['class' => 'form-control form-control-sm']); ?></td>
                        <td><?php $this->Form->fieldText('exist_email' . $i, $this->Html->ifSet($vars->{'exist_email' . $i}), ['class' => 'form-control form-control-sm']); ?></td>
                        <td><button type="button" class="btn btn-sm btn-outline-danger delete_row" title="<?php echo $this->Html->safe($this->_('Blesta.delete', true)); ?>"><i class="bi bi-trash"></i></button></td>
                    </tr>
                    <?php
                    $i++;
                } while (isset($vars->{'username' . $i}));
                ?>
            </tbody>
        </table>
    </div>
    <div class="d-flex justify-content-end gap-2">
        <?php $this->Form->fieldSubmit('save', $this->_('Dynadot.tab_email_forwarding.field_submit', true), ['class' => 'btn btn-primary']); ?>
    </div>
</div>
<?php $this->Form->end(); ?>

<script type="text/javascript">
(function () {
    var record_count = <?php echo (int) $i; ?>;
    var table = document.getElementById('email_forwards');
    var add = document.getElementById('add_forward');
    if (!table || !add) {
        return;
    }
    var body = table.querySelector('tbody');

    add.addEventListener('click', function (e) {
        e.preventDefault();
        var clone = body.querySelector('tr').cloneNode(true);
        clone.querySelectorAll('input').forEach(function (el) {
            var name = el.getAttribute('name');
            if (name) {
                var new_name = name.replace(/\d+$/, record_count);
                el.setAttribute('name', new_name);
                el.setAttribute('id', new_name);
            }
            el.value = '';
        });
        body.appendChild(clone);
        record_count++;
    });

    table.addEventListener('click', function (e) {
        var btn = e.target.closest('.delete_row');
        if (!btn) {
            return;
        }
        e.preventDefault();
        var row = btn.closest('tr');
        if (body.querySelectorAll('tr').length > 1) {
            row.remove();
        } else {
            row.querySelectorAll('input').forEach(function (el) { el.value = ''; });
        }
    });
})();
</script>
