<?php $this->Form->create(); ?>
<div class="p-3">
    <h6 class="form-section-header"><?php $this->_('Dynadot.tab_whois.title'); ?></h6>
    <?php
    foreach (['Registrant', 'Admin', 'Technical', 'Billing'] as $section) {
        ?>
        <h6 class="mt-3"><?php $this->_('Dynadot.tab_whois.section_' . strtolower($section)); ?></h6>
        <div class="row g-3">
            <?php
            foreach ($fields as $key => $field) {
                if (strpos($key, $section) !== 0) {
                    continue;
                }
                ?>
                <div class="col-md-6">
                    <?php
                    $this->Form->label($field['label'], $key, ['class' => 'form-label']);
                    $this->Form->fieldText($key, $vars->{$key} ?? null, ['id' => $key, 'class' => 'form-control']);
                    ?>
                </div>
                <?php
            }
            ?>
        </div>
        <?php
    }
    ?>
    <div class="d-flex justify-content-end gap-2 mt-3">
        <?php $this->Form->fieldSubmit('save', $this->_('Dynadot.tab_whois.field_submit', true), ['class' => 'btn btn-primary']); ?>
    </div>
</div>
<?php $this->Form->end(); ?>
