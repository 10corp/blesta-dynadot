<?php
$this->Form->create();
$this->Form->fieldHidden('contact_id', $contact_id ?? null);
?>
<div class="p-3">
    <h6 class="form-section-header"><?php $this->_('Dynadot.tab_edit_contact.title'); ?></h6>
    <?php
    foreach ($fields as $key => $field) {
        ?>
        <div class="mb-3">
            <?php
            $this->Form->label($field['label'], $key, ['class' => 'form-label']);
            $this->Form->fieldText($key, $vars->{$key} ?? null, ['id' => $key, 'class' => 'form-control']);
            ?>
        </div>
        <?php
    }
    ?>
    <div class="d-flex justify-content-end gap-2">
        <?php $this->Form->fieldSubmit('save', $this->_('Dynadot.tab_edit_contact.field_submit', true), ['class' => 'btn btn-primary']); ?>
    </div>
</div>
<?php $this->Form->end(); ?>
